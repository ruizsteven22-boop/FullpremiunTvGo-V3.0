# Puerto del servidor Node.js
PORT=3000
NODE_ENV=production

# Seguridad Administración (OBLIGATORIO en producción)
ADMIN_PASSWORD=cambia-esta-clave-maestra-segura
ADMIN_SESSION_SECRET=genera-una-clave-aleatoria-larga-de-64-caracteres

# Orígenes permitidos para CORS y Proxy /api/proxy (separados por coma)
ALLOWED_ORIGINS=https://app.fullpremiumtvcl.com,http://app.fullpremiumtvcl.com

# Mercado Pago Chile
MP_PUBLIC_KEY=APP_USR-tu-public-key
MP_ACCESS_TOKEN=APP_USR-tu-access-token
MP_WEBHOOK_SECRET=tu-webhook-secret-de-mercadopago

# Correo SMTP Hostinger (activaciones)
EMAIL_USER=activaciones@app.fullpremiumtvcl.com
EMAIL_PASS=tu-password-smtp
